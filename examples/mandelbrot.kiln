// The Mandelbrot set, zooming forever into a spiral.
// Each pixel iterates z = z * z + c up to a few hundred times, where z and
// c are complex numbers: a struct with its own '*' operator.
// Smooth coloring hides the bands.

struct Complex { re: float, im: float }

impl Complex {
  // (a + bi)(c + di) = (ac - bd) + (ad + bc)i
  fn *(self, o: Complex) -> Complex {
    return Complex(self.re * o.re - self.im * o.im, self.re * o.im + self.im * o.re);
  }
  // '+' isn't defined here: structs whose fields are all floats already add
  // component-wise, which is exactly complex addition.
  fn abs2(self) -> float {
    return self.re * self.re + self.im * self.im;
  }
}

let CENTER = Complex(-0.743643887037151, 0.131825904205330);

fn palette(t: float) -> int {
  return rgbf(0.5 + 0.5 * cos(TAU * (t + 0.0)),
              0.5 + 0.5 * cos(TAU * (t + 0.1)),
              0.5 + 0.5 * cos(TAU * (t + 0.2)));
}

fn frame(t: float) {
  let phase = t % 36.0;             // zoom in for 36 seconds, then restart
  let zoom = pow(1.45, phase);
  let scale = 3.0 / (zoom * HEIGHT as float);
  let max_iter = 120 + (phase * 12.0) as int;

  for py in 0..HEIGHT {
    for px in 0..WIDTH {
      let c = CENTER + Complex((px - WIDTH / 2) as float, (py - HEIGHT / 2) as float) * scale;
      var z = Complex(0.0, 0.0);
      var i = 0;
      while i < max_iter && z.abs2() < 256.0 {
        z = z * z + c;
        i += 1;
      }
      if i == max_iter {
        pixel(px, py, 0x000000);
      } else {
        // fractional iteration count -> no visible bands
        let smooth = i as float + 1.0 - log(log(sqrt(z.abs2()))) / log(2.0);
        pixel(px, py, palette(smooth * 0.02 + t * 0.03));
      }
    }
  }
}

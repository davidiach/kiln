// A Julia set, four pixels at a time.
// An f32x4 holds four 32-bit floats in one WebAssembly SIMD register, so
// every + and * below works on four pixels at once. A boolx4 mask keeps
// track of which of the four are still iterating, and even the coloring's
// logarithms are computed four at a time.

struct C4 { re: f32x4, im: f32x4 }   // four complex numbers

impl C4 {
  // (a + bi)(c + di) = (ac - bd) + (ad + bc)i, in all four lanes
  fn *(self, o: C4) -> C4 {
    return C4(self.re * o.re - self.im * o.im, self.re * o.im + self.im * o.re);
  }
  fn abs2(self) -> f32x4 {
    return self.re * self.re + self.im * self.im;
  }
}

let MAX_ITER = 128;
let LANES = f32x4(0.0, 1.0, 2.0, 3.0);   // x offsets of the four pixels

var colors: [int; 256];   // the palette, computed once

fn main() {
  for i in 0..len(colors) {
    let t = i as float / len(colors) as float;
    colors[i] = rgbf(0.5 + 0.5 * cos(TAU * (t + 0.0)),
                     0.5 + 0.5 * cos(TAU * (t + 0.1)),
                     0.5 + 0.5 * cos(TAU * (t + 0.2)));
  }
}

// log2 of four positive floats at once, without leaving SIMD.
// An f32 is stored as 2^e * m with m in [1, 2), and to_bits() lets us read
// e straight out of bits 23..30. For m, log2(m) = 2/ln(2) * atanh(s) with
// s = (m - 1) / (m + 1), and atanh(s) = s + s^3/3 + s^5/5 + s^7/7 + ...
// converges fast because s < 1/3.
fn log2v(x: f32x4) -> f32x4 {
  let bits = to_bits(x);
  let e = ((bits >> 23) & 255) - 127;
  let m = from_bits((bits & 0x7fffff) | 0x3f800000);   // same mantissa, exponent 0
  let s = (m - 1.0) / (m + 1.0);
  let s2 = s * s;
  return e as f32x4 + s * (2.8853901 + s2 * (0.9617967 + s2 * (0.5770780 + s2 * 0.4121986)));
}

// Color four pixels: black inside the set, a palette color outside.
fn shade4(x: int, y: int, n: i32x4, z2: f32x4, t: float) {
  // fractional iteration count -> no visible bands:
  // n + 1 - log2(ln|z|), where ln|z| = ln(2)/2 * log2(|z|^2)
  let smooth = n as f32x4 + 1.0 - log2v(0.34657359 * log2v(z2));
  let k = ((smooth * 12.0 + t * 20.0) as i32x4) & 255;
  let rgb = i32x4(colors[k.x], colors[k.y], colors[k.z], colors[k.w]);
  let c = select(n == MAX_ITER, 0x000000, rgb);
  pixel(x, y, c.x);
  pixel(x + 1, y, c.y);
  pixel(x + 2, y, c.z);
  pixel(x + 3, y, c.w);
}

fn frame(t: float) {
  // c circles just outside the edge of the Mandelbrot set's main
  // cardioid, where the Julia sets are full of spirals
  let a = t * 0.15;
  let cr = 1.02 * (0.5 * cos(a) - 0.25 * cos(2.0 * a));
  let ci = 1.02 * (0.5 * sin(a) - 0.25 * sin(2.0 * a));
  let c = C4(f32x4(cr), f32x4(ci));
  let scale = 3.0 / HEIGHT as float;
  for py in 0..HEIGHT {
    let im = f32x4((py - HEIGHT / 2) as float * scale);
    for qx in 0..WIDTH / 4 {
      let px = qx * 4;
      var z = C4((LANES + (px - WIDTH / 2) as float) * scale, im);
      var n = i32x4(0);
      for i in 0..MAX_ITER {
        let inside = z.abs2() < 256.0;      // which lanes haven't escaped
        if !any(inside) { break; }
        n += inside as i32x4;               // count only those
        let next = z * z + c;
        z = C4(select(inside, next.re, z.re), select(inside, next.im, z.im));
      }
      shade4(px, py, n, z.abs2(), t);
    }
  }
}

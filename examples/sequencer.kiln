// Step sequencer: click the grid to switch notes on and off (drag to paint).
// A playhead loops over 16 steps and plays every lit cell in its column.
// Keys: R makes a random pattern, C clears the grid.
//
// Notes are scheduled a moment ahead with sound_at, on the same clock as
// t, so the beat stays steady even when a frame arrives late.
// (Browsers only play sound after you click on the page.)

const COLS = 16;
const ROWS = 10;
const CELL = 17;
const GRID_X = (WIDTH - COLS * CELL) / 2;
const GRID_Y = 34;
const BPM = 112.0;
const STEP = 15.0 / BPM;       // one sixteenth note, in seconds
const LOOKAHEAD = 0.1;

// Rows 0-7 are a C major pentatonic scale, highest at the top, so any
// pattern sounds pleasant. Row 8 is a hi-hat and row 9 a kick drum.
let SCALE = [84, 81, 79, 76, 74, 72, 69, 67];
const HAT = 8;
const KICK = 9;

// The pattern you hear first: one melody note (a row) per step, -1 = rest.
let MELODY = [5, -1, 3, 2, -1, 3, 4, -1, 6, -1, 5, 4, 3, -1, 7, -1];

var on: [bool; COLS * ROWS];
var played_at: [float; COLS];  // when each column last started playing
var next_col = 0;
var next_time = 0.0;
var was_down = false;
var painting = true;
var r_was_down = false;
var c_was_down = false;

fn cell(col: int, row: int) -> int {
  return row * COLS + col;
}

fn play_row(row: int, time: float) {
  if row == KICK {
    sound_at(time, WAVE_SINE, 160.0, 42.0, 0.28, 1.0);
  } else if row == HAT {
    sound_at(time, WAVE_NOISE, 9000.0, 5000.0, 0.05, 0.35);
  } else {
    let f = note(SCALE[row]);
    sound_at(time, WAVE_TRIANGLE, f, f, 0.32, 0.45);
    sound_at(time, WAVE_SQUARE, f * 2.0, f * 2.0, 0.05, 0.06);  // a little bite on the attack
  }
}

fn play_column(col: int, time: float) {
  for row in 0..ROWS {
    if on[cell(col, row)] { play_row(row, time); }
  }
  played_at[col] = time;
}

fn clear_grid() {
  for i in 0..COLS * ROWS { on[i] = false; }
}

fn randomize() {
  clear_grid();
  for col in 0..COLS {
    if rand() < 0.55 { on[cell(col, (rand() * 8.0) as int)] = true; }
    on[cell(col, HAT)] = col % 2 == 1 && rand() < 0.7;
    on[cell(col, KICK)] = col % 4 == 0 || rand() < 0.1;
  }
}

fn main() {
  for col in 0..COLS {
    if MELODY[col] >= 0 { on[cell(col, MELODY[col])] = true; }
    on[cell(col, KICK)] = col % 4 == 0;
    on[cell(col, HAT)] = col % 4 == 2;
  }
}

fn handle_input(t: float) {
  let down = mouse_down();
  let mx = mouse_x() - GRID_X;
  let my = mouse_y() - GRID_Y;
  if down && mx >= 0 && my >= 0 && mx < COLS * CELL && my < ROWS * CELL {
    let col = mx / CELL;
    let row = my / CELL;
    let i = cell(col, row);
    // The first cell you press decides whether this drag paints or erases.
    if !was_down { painting = !on[i]; }
    if on[i] != painting {
      on[i] = painting;
      if painting { play_row(row, t); }   // hear it right away
    }
  }
  was_down = down;

  let r = key_down(82);
  let c = key_down(67);
  if r && !r_was_down { randomize(); }
  if c && !c_was_down { clear_grid(); }
  r_was_down = r;
  c_was_down = c;
}

fn draw(t: float) {
  clear(0x0d0b1a);
  text_big(GRID_X, 10, "STEP SEQUENCER", 2, 0xe8e4ff);

  // The playhead is on the column that most recently started.
  var current = 0;
  var latest = -1.0;
  for col in 0..COLS {
    if played_at[col] <= t && played_at[col] > latest {
      latest = played_at[col];
      current = col;
    }
  }

  for col in 0..COLS {
    let x = GRID_X + col * CELL;
    if col == current { rect(x, GRID_Y - 3, CELL, ROWS * CELL + 6, 0x262046); }
    let age = t - played_at[col];
    let flash = age >= 0.0 && age < 0.3 ? 1.0 - age / 0.3 : 0.0;
    for row in 0..ROWS {
      let y = GRID_Y + row * CELL;
      var color = col % 4 == 0 ? 0x2c2752 : 0x211d3f;
      if on[cell(col, row)] {
        var base = hsv(0.55 + row as float * 0.045, 0.6, 0.95);
        if row == HAT { base = 0xc3cde0; }
        if row == KICK { base = 0xff7a59; }
        color = blend(blend(base, 0x000000, 0.2), 0xffffff, flash * 0.65);
      }
      rect(x + 1, y + 1, CELL - 2, CELL - 2, color);
    }
  }

  text(4, GRID_Y + HAT * CELL + 6, "HH", 0x8a84b0);
  text(4, GRID_Y + KICK * CELL + 6, "BD", 0x8a84b0);
  text(GRID_X, 220, "CLICK CELLS     R: RANDOM     C: CLEAR", 0x8a84b0);
}

fn frame(t: float) {
  // If we fell far behind (say the tab was hidden), skip ahead instead of
  // playing everything we missed at once.
  if next_time < t - 0.25 { next_time = t; }
  // Schedule every step that starts within the next LOOKAHEAD seconds.
  while next_time < t + LOOKAHEAD {
    play_column(next_col, next_time);
    next_col = (next_col + 1) % COLS;
    next_time += STEP;
  }
  handle_input(t);
  draw(t);
}

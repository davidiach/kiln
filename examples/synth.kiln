// A playable synthesizer, written sample by sample.
// audio(t) runs for every sample, sample_rate() times a second, and
// computes the sound itself: four voices at once in one f32x4, each a
// sawtooth with its own envelope, through a low-pass filter.
//
// Play with the keys  A W S E D F T G Y H U J K  (or click the keys on
// screen), and move the mouse across the oscilloscope to sweep the filter.

let KEYS = [65, 87, 83, 69, 68, 70, 84, 71, 89, 72, 85, 74, 75];   // one per semitone, C to C
let BLACK = [false, true, false, true, false, false, true, false, true, false, true, false, false];
let WHITE_INDEX = [0, 0, 1, 1, 2, 3, 3, 4, 4, 5, 5, 6, 7];          // the white key at or left of each

// frame() decides what plays; audio() plays it (they share globals)
var freq = f32x4(220.0);   // the four voices' pitches
var gate = f32x4(0.0);     // 1 while a voice's key is held
var cutoff = 0.12;         // the filter, 0 (dark) .. 1 (bright)

// the synthesizer's state, updated every sample
var phase = f32x4(0.0);
var env = f32x4(0.0);
var low = 0.0;             // the filter's memory
var scope: [float; 1024];  // recent output, for the oscilloscope
var scope_at = 0;

fn audio(t: float) -> float {
  let rate = sample_rate();
  phase += freq / rate;
  phase -= floor(phase);                  // keep each phase in 0..1
  let saw = phase * 2.0 - 1.0;
  // envelopes move toward their gates: quickly up, slowly down
  env += (gate - env) * select(gate > env, 80.0, 5.0) / rate;
  let v = saw * env;
  let mix = (v.x + v.y + v.z + v.w) * 0.5;
  low += (mix - low) * cutoff * cutoff;   // a one-pole low-pass filter
  let out = low / (1.0 + abs(low));       // a soft clip, for chords
  scope[scope_at] = out;
  scope_at = (scope_at + 1) % len(scope);
  return out;
}

// --------------------------------------------------------------- keys

fn key_x(i: int) -> int {
  if BLACK[i] { return (WHITE_INDEX[i] + 1) * 40 - 12; }
  return WHITE_INDEX[i] * 40;
}

fn key_w(i: int) -> int {
  return BLACK[i] ? 24 : 40;
}

fn key_bottom(i: int) -> int {
  return BLACK[i] ? 210 : 239;
}

/** The key under the mouse, black keys first since they sit on top; -1 if none. */
fn key_at(x: int, y: int) -> int {
  if y < 160 { return -1; }
  for pass in 0..2 {
    for i in 0..len(KEYS) {
      if BLACK[i] == (pass == 0) && x >= key_x(i) && x < key_x(i) + key_w(i) && y < key_bottom(i) {
        return i;
      }
    }
  }
  return -1;
}

fn with_lane(v: f32x4, lane: int, value: float) -> f32x4 {
  var r = v;
  if lane == 0 { r.x = value; } else if lane == 1 { r.y = value; } else if lane == 2 { r.z = value; } else { r.w = value; }
  return r;
}

// ------------------------------------------------------------- frame

fn frame(t: float) {
  // the first four held keys get the four voices
  let clicked = mouse_down() ? key_at(mouse_x(), mouse_y()) : -1;
  var g = f32x4(0.0);
  var voices = 0;
  for i in 0..len(KEYS) {
    if (key_down(KEYS[i]) || i == clicked) && voices < 4 {
      freq = with_lane(freq, voices, note(60 + i));
      g = with_lane(g, voices, 1.0);
      voices += 1;
    }
  }
  gate = g;
  if mouse_y() < 150 { cutoff = 0.05 + 0.9 * clamp(mouse_x() as float / WIDTH as float, 0.0, 1.0); }

  clear(rgb(16, 18, 28));
  draw_scope();
  draw_keys(clicked);
  text(8, 8, "PLAY A W S E D F T G Y H U J K", rgb(150, 160, 190));
  rect(8, 145, (cutoff * 304.0) as int, 3, rgb(255, 170, 60));
}

fn draw_scope() {
  // start at a rising zero crossing, so the wave stands still
  let n = len(scope);
  var start = (scope_at - 640 + n) % n;
  for k in 0..300 {
    let i = (start + k) % n;
    if scope[i] <= 0.0 && scope[(i + 1) % n] > 0.0 {
      start = i;
      break;
    }
  }
  var py = 0;
  for x in 0..WIDTH {
    let y = 80 - (scope[(start + x) % n] * 55.0) as int;
    if x > 0 { line(x - 1, py, x, y, rgb(120, 230, 170)); }
    py = y;
  }
}

fn draw_keys(clicked: int) {
  for pass in 0..2 {
    for i in 0..len(KEYS) {
      if BLACK[i] == (pass == 1) {
        let down = key_down(KEYS[i]) || i == clicked;
        var c = BLACK[i] ? rgb(30, 30, 40) : rgb(235, 235, 240);
        if down { c = rgb(255, 170, 60); }
        rect(key_x(i) + 1, 160, key_w(i) - 2, key_bottom(i) - 160, c);
      }
    }
  }
}

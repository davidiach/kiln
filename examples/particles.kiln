// Particle fountain: 4000 particles with gravity, bouncing off the floor.
// The fountain follows your mouse. The screen fades a little every frame
// instead of being cleared, which leaves glowing trails.

const N = 4000;
var px: [float; N];
var py: [float; N];
var vx: [float; N];
var vy: [float; N];
var life: [float; N];
var color: [int; N];
var next = 0;
var last_t = 0.0;
var ex = 160.0;
var ey = 200.0;

// Add two colors channel by channel, saturating at 255: light adds up.
fn add(a: int, b: int) -> int {
  let r = min(((a >> 16) & 255) + ((b >> 16) & 255), 255);
  let g = min(((a >> 8) & 255) + ((b >> 8) & 255), 255);
  let bl = min((a & 255) + (b & 255), 255);
  return (r << 16) | (g << 8) | bl;
}

fn spawn(t: float) {
  let i = next;
  next = (next + 1) % N;
  let angle = -PI / 2.0 + (rand() - 0.5) * 0.7;
  let speed = 140.0 + rand() * 90.0;
  px[i] = ex;
  py[i] = ey;
  vx[i] = cos(angle) * speed;
  vy[i] = sin(angle) * speed;
  life[i] = 1.0;
  color[i] = hsv(t * 0.08 + rand() * 0.15, 0.75, 0.7);
}

fn frame(t: float) {
  let dt = clamp(t - last_t, 0.0, 0.05);
  last_t = t;

  // Fade everything to 3/4 brightness.
  for i in 0..WIDTH * HEIGHT {
    let c = screen[i];
    screen[i] = ((c >> 1) & 0x7f7f7f) + ((c >> 2) & 0x3f3f3f);
  }

  // The emitter eases toward the mouse.
  ex = mix(ex, mouse_x() as float, 0.15);
  ey = mix(ey, clamp(mouse_y() as float, 40.0, 235.0), 0.15);
  for k in 0..40 { spawn(t); }

  for i in 0..N {
    if life[i] <= 0.0 { continue; }
    vy[i] += 260.0 * dt;
    px[i] += vx[i] * dt;
    py[i] += vy[i] * dt;
    if py[i] > HEIGHT as float - 1.0 {
      py[i] = HEIGHT as float - 1.0;
      vy[i] *= -0.55;
      vx[i] *= 0.8;
    }
    if px[i] < 0.0 || px[i] >= WIDTH as float { vx[i] = -vx[i]; }
    life[i] -= dt * 0.35;

    let x = px[i] as int;
    let y = py[i] as int;
    if x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT {
      let k = y * WIDTH + x;
      screen[k] = add(screen[k], color[i]);
    }
  }
  text(4, 4, "MOVE THE MOUSE", 0x808080);
}
